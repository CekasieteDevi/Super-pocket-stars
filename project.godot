; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Pocket Stars"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://game/game_state.gd"

[display]

; Resolucion de referencia: es la que se uso para disenar y capturar toda
; la UI. Con stretch canvas_items + expand, en un celular la pantalla se
; escala a esto y se gana o pierde a los costados segun la relacion de
; aspecto real del telefono.
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; El juego es horizontal (GDD). 4 = SENSOR_LANDSCAPE: queda apaisado
; siempre pero se puede girar entre las dos orientaciones horizontales.
; OJO con el numero: en el enum de Godot 0 es landscape y 1 es PORTRAIT,
; asi que un 1 aca deja el juego de costado en el telefono.
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

# OpenGL evita el crash de acceso a memoria del editor Godot en este entorno.
rendering_device/driver.windows="opengl3"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

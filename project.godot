; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Pocket Stars"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://game/game_state.gd"

[display]

; Resolucion de referencia: es la que se uso para disenar y capturar toda
; la UI. Con stretch canvas_items + expand, en un celular la pantalla se
; escala a esto y se gana o pierde a los costados segun la relacion de
; aspecto real del telefono.
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; El juego es horizontal (GDD): en el celular se fuerza apaisado.
window/handheld/orientation=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Requerido para exportar a Android: sin esto Godot rechaza el export.
textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
